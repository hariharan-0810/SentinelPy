# Copy to .env (already git-ignored) and fill in. Real environment variables override this file.
# Gmail example: enable 2-step verification, then create an "App password" - never use your normal password.
SENTINELPY_SMTP_HOST=smtp.gmail.com
SENTINELPY_SMTP_PORT=587
SENTINELPY_SMTP_SECURITY=starttls
SENTINELPY_SMTP_USER=you@gmail.com
SENTINELPY_SMTP_PASSWORD=your-app-password
SENTINELPY_MAIL_FROM=you@gmail.com
SENTINELPY_MAIL_TO=you@gmail.com,teammate@example.com
# Email alerts at or above this severity: Low | Medium | High | Critical
SENTINELPY_NOTIFY_MIN_SEVERITY=High
# Minimum seconds between non-critical emails (Critical alerts always send immediately)
SENTINELPY_NOTIFY_MIN_INTERVAL=60
